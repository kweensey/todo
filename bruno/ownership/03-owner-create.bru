meta {
  name: Owner creates private task
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/task
  body: json
  auth: bearer
}

auth:bearer {
  token: {{owner_access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Owner private task"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("owner_task_uuid", res.getBody().uuid);
}

tests {
  test("Task created", () => { expect(res.getStatus()).to.equal(201); });
}
