meta {
  name: Original owner still owns the task
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/task/{{owner_task_uuid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{owner_access_token}}
}

tests {
  test("Owner can access", () => { expect(res.getStatus()).to.equal(200); });
  test("Owner title unchanged", () => { expect(res.getBody()).to.include('value="Owner private task"'); });
}
