meta {
  name: Completed task offers reopen action
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/task
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("HTTP 200", () => { expect(res.getStatus()).to.equal(200); });
  test("Task is completed", () => { expect(res.getBody()).to.include('/task/' + bru.getVar('task_uuid') + '/reopen'); });
}
