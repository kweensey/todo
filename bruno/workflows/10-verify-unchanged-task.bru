meta {
  name: Invalid update did not overwrite saved title
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/task/{{task_uuid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("HTTP 200", () => { expect(res.getStatus()).to.equal(200); });
  test("Title unchanged", () => { expect(res.getBody()).to.include('value="Bruno updated task"'); });
}
