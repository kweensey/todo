meta {
  name: Rotate refresh token
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("refresh_token", res.getBody().refresh_token);
  }
}

tests {
  test("HTTP 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response contains refresh token", () => {
    expect(res.getBody().refresh_token).to.be.a("string").and.not.empty;
  });
}
