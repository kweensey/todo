meta {
  name: Log in
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/auth/access
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("access_token", res.getBody().access_token);
    bru.setVar("refresh_token", res.getBody().refresh_token);
  }
}

tests {
  test("HTTP 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response contains access token", () => {
    expect(res.getBody().access_token).to.be.a("string").and.not.empty;
  });
  test("Refresh token exists", () => { expect(res.getBody().refresh_token).to.be.a("string").and.not.empty; });
}
