{
  "require": {
    "php": "^8.3",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "oasys/core": "^1",
    "oasys/config": "^1",
    "oasys/validator": "^1",
    "psr/log": "^3",
    "php-di/php-di": "^7",
    "guzzlehttp/psr7": "^2",
    "monolog/monolog": "^3",
    "twig/twig": "^3",
    "illuminate/database": "^13",
    "ramsey/uuid": "^4",
    "firebase/php-jwt": "^7",
    "phpmailer/phpmailer": "^7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform-check": true
  },
  "scripts": {
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t public"
    ],
    "setup": "@php scripts/setup.php",
    "bootstrap:db": "@php scripts/bootstrap-db.php",
    "bootstrap:admin": "@php scripts/bootstrap-admin.php",
    "test": "phpunit",
    "test:unit": "@php vendor/bin/phpunit --testsuite Unit",
    "test:integration": "@php vendor/bin/phpunit --testsuite Integration",
    "seed:bruno": "@php scripts/seed-bruno-users.php"
  }
}
