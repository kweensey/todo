{% extends 'layout/fluid.html.twig' %}

{% import 'macro/buttons.html.twig' as button %}
{% import 'macro/form.html.twig' as form %}

{% block javascript %}
  <script src="/assets/js/user/registerPassword.js"></script>
{% endblock %}

{% block main %}
  <h6 class="my-5 text-center">Zvolte si své bezpečnostní heslo</h6>
  <form id="user_register_password" data-form-action="/user/{{ user.uuid }}/register/password" novalidate>
    <div class="mb-4">
      {{ form.password('Heslo', 'password') }}
      {{ form.feedback('password') }}
    </div>
    <div class="mb-5">
      {{ form.password('Heslo znovu', 'password_check') }}
      {{ form.feedback('password_check') }}
    </div>
    <div class="text-center">
      {% if token %}
        {{ form.hidden('token', token) }}
      {% endif %}
      {{ button.submit('Pokračovat', 'check') }}
    </div>
  </form>
{% endblock %}
