{% import 'macro/buttons.html.twig' as button %}
{% import 'macro/form.html.twig' as form %}

<div class="modal-content border-0 p-4 shadow">
  <div class="modal-header border-0">
    <h1 class="modal-title fs-5 text-truncate">
      <i class="fa-regular fa-lock me-2 text-muted"></i>
      Změna hesla
    </h1>
    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <form id="user_change_password" data-form-action="/user/me/change/password">
    <div class="modal-body">
      <div class="row mb-4">
        <div class="col-md-6">
          {{ form.password('Původní heslo', 'password_current', 'current-password') }}
          {{ form.feedback('password_current') }}
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-4">
          {{ form.password('Nové heslo', 'password_new') }}
          {{ form.feedback('password_new') }}
        </div>
        <div class="col-md-6 mb-4">
          {{ form.password('Nové heslo znovu', 'password_check') }}
          {{ form.feedback('password_check') }}
        </div>
      </div>
    </div>
    <div class="modal-footer border-0 justify-content-center">
      {{ button.submit('Pokračovat', 'check') }}
    </div>
  </form>
</div>

<script src="/assets/js/user/changePassword.js"></script>
