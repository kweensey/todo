{% extends 'layout/fluid.html.twig' %}

{% import 'macro/buttons.html.twig' as button %}
{% import 'macro/form.html.twig' as form %}

{% block javascript %}
  <script src="/assets/js/user/recoveryPassword.js"></script>
{% endblock %}

{% block main %}
  <h6 class="my-5 text-center">Zvolte si nové bezpečnostní heslo</h6>
  <form id="user_recovery_password" novalidate>
    <div class="mb-4">
      {{ form.password('Heslo', 'password') }}
      {{ form.feedback('password') }}
    </div>
    <div class="mb-5">
      {{ form.password('Heslo znovu', 'password_check') }}
      {{ form.feedback('password_check') }}
    </div>
    <div class="text-center">
      {{ form.hidden('token', token) }}
      {{ button.submit('Pokračovat', 'check') }}
    </div>
  </form>
{% endblock %}
